# Copy to .env and edit. Every value below is a FAKE placeholder, never commit real secrets.
APP_NAME=Portfolio API
# development | production
APP_ENV=development
DEBUG=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio
DB_USER=postgres
# Special characters (@ : /) are fine, the app URL-encodes the password.
DB_PASSWORD=change-me
# Full SQLAlchemy URL that bypasses the DB_* values (the tests use it). Leave empty normally.
DATABASE_URL_OVERRIDE=

# Browser origin allowed by CORS (the Angular dev server).
FRONTEND_URL=http://localhost:4200

# Admin API token sent in the X-Admin-Token header. Empty = admin API disabled (404).
ADMIN_TOKEN=
# Salt mixed into the SHA-256 of client IPs before storing them.
IP_HASH_SALT=replace-with-a-long-random-string
# Max contact messages per client IP per hour.
CONTACT_RATE_LIMIT_PER_HOUR=3
# true ONLY behind a trusted reverse proxy: then the client IP is read from X-Forwarded-For.
TRUSTED_PROXY=false

# Optional: path of the shared content file used by `python -m app.seed`.
# CONTENT_FILE=../content/content.json
